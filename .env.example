# Neon Postgres
DATABASE_URL=            # pooled connection string
DATABASE_URL_UNPOOLED=   # direct connection string (migrations)

# better-auth
BETTER_AUTH_SECRET=      # long random string
BETTER_AUTH_URL=         # http://localhost:3000 locally, your domain in production

# Google OAuth (Google Cloud Console → Credentials)
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google emails that can open /admin
ADMIN_EMAILS=
